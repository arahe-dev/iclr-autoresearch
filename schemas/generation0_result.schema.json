      "properties": {
        "status": {
          "const": "PASS"
        },
        "frozen_corpus": {
          "const": "PASS"
        },
        "frozen_contract": {
          "const": "PASS"
        },
        "selected_treatment": {
          "const": "PASS"
        },
        "initial_loss": {
          "const": "PASS"
        },
        "oracle_before_timing": {
          "const": true
        },
