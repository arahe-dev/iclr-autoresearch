            },
            "vram_GiB": {
              "type": "number",
              "minimum": 90
            },
            "name": {
              "const": "NVIDIA RTX PRO 6000 Blackwell Server Edition"
            },
            "device": {
              "const": "NVIDIA RTX PRO 6000 Blackwell Server Edition"
            }
          },
          "additionalProperties": true,
          "anyOf": [
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "device"
              ]
            }
          ]
        },
        "champion_immutable": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "const": "MEASURED_G0_B32_FB"
    }
