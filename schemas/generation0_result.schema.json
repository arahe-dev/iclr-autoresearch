{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icrl-autoresearch.local/schemas/generation0_result.schema.json",
  "title": "Generation-0 exact-BDH screening result",
  "type": "object",
  "required": ["schema_version", "plan_id", "source_commit", "run_id", "arm_id", "block_id", "oracle", "latency_ms", "real_input_tok_s", "decision"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "plan_id": {"type": "string", "const": "G0-L8-SM120-EXACT-B32"},
    "source_commit": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^G0-R[0-9]{2}$"},
    "arm_id": {"type": "string", "pattern": "^(G0-(?:[0-9]{2}|F[0-9]{2})|CONTROL)$"},
    "block_id": {"type": "integer", "minimum": 1},
    "within_block_position": {"type": "integer", "minimum": 1},
    "oracle": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "const": "PASS"},
        "forward_rel_l2": {"type": "number"},
        "dq_rel_l2": {"type": "number"},
        "dv_rel_l2": {"type": "number"},
        "same_document_reset": {"type": "string", "const": "PASS"},
        "tied_qk_backward": {"type": "string", "const": "PASS"}
      },
      "additionalProperties": true
    },
    "latency_ms": {"type": "number", "exclusiveMinimum": 0},
    "real_input_tok_s": {"type": "number", "exclusiveMinimum": 0},
    "peak_GiB": {"type": ["number", "null"]},
    "thermal": {"type": "object"},
    "decision": {"type": "string"},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": true
}
