{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icrl-autoresearch.local/schemas/generation0_result.schema.json",
  "title": "C15 accepted Generation-0 result (worker output is pending supervisor admission)",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "source_commit",
    "harness_commit",
    "run_id",
    "arm_id",
    "treatment_id",
    "attempt_id",
    "block_id",
    "within_block_position",
    "selected_levels",
    "oracle",
    "latency_ms",
    "real_input_tok_s",
    "peak_GiB",
    "samples_ms",
    "warmups",
    "timed_repetitions",
    "timing",
    "memory",
    "provenance",
    "validation",
    "admission",
    "execution",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "plan_id": {
      "const": "G0-L8-SM120-EXACT-B32-C15"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "harness_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^G0-R(0[1-46-9]|[12][0-9]|3[0-9]|4[1-9]|5[0-2])$"
    },
    "arm_id": {
      "enum": [
        "CONTROL",
        "G0-00",
        "G0-01",
        "G0-02",
        "G0-03",
        "G0-04",
        "G0-05",
        "G0-06",
        "G0-07",
        "G0-F00",
        "G0-F01",
        "G0-F02",
        "G0-F03",
        "G0-F04",
        "G0-F06",
        "G0-F07"
      ]
    },
    "treatment_id": {
      "enum": [
        "G0-00",
        "G0-01",
        "G0-02",
        "G0-03",
        "G0-04",
        "G0-05",
        "G0-06",
        "G0-07",
        "G0-F00",
        "G0-F01",
        "G0-F02",
        "G0-F03",
        "G0-F04",
        "G0-F06",
        "G0-F07"
      ]
    },
    "block_id": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "within_block_position": {
      "type": "integer",
      "minimum": 1,
      "maximum": 26
    },
    "selected_levels": {
      "type": "object",
      "required": [
        "full_symmetric_qk_sm120",
        "qk_backward",
        "dx_gemm_backend",
        "dy_gemm_backend",
        "e_gemm",
        "dy_relu_epilogue_layout",
        "checkpoint_policy"
      ],
      "properties": {
        "full_symmetric_qk_sm120": {
          "enum": [
            "control_full_symmetric_qk",
            "native_sm120_full_symmetric_qk"
          ]
        },
        "qk_backward": {
          "enum": [
            "control_tied_qk_vjp",
            "native_tied_qk_vjp"
          ]
        },
        "dx_gemm_backend": {
          "enum": [
            "control_dx_gemm",
            "native_sm120_dx_gemm"
          ]
        },
        "dy_gemm_backend": {
          "enum": [
            "control_dy_gemm",
            "native_sm120_dy_gemm"
          ]
        },
        "dy_relu_epilogue_layout": {
          "enum": [
            "materialized_baseline_layout",
            "exact_dy_relu_epilogue_layout"
          ]
        },
        "e_gemm": {
          "enum": [
            "reference_e_gemm",
            "native_sm120_e_gemm"
          ]
        },
        "checkpoint_policy": {
          "enum": [
            "gram_only_sac",
            "selective_exact_projection_only"
          ]
        }
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "required": [
        "status",
        "same_document_reset",
        "tied_qk_backward",
        "initial_loss_gate",
        "initial_loss",
        "forward_rel_l2",
        "dq_rel_l2",
        "dv_rel_l2",
        "projection_rel_l2",
        "projection_grad_rel_l2",
        "forward_max_abs"
