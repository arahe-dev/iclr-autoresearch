      "properties": {
        "status": {
          "const": "PASS"
        },
        "same_document_reset": {
          "const": "PASS"
        },
        "tied_qk_backward": {
          "const": "PASS"
        },
        "initial_loss_gate": {
          "const": "PASS"
        },
        "initial_loss": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "forward_rel_l2": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.0003
        },
        "dq_rel_l2": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.0003
        },
        "dv_rel_l2": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.0003
        },
        "projection_rel_l2": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.0003
        },
        "projection_grad_rel_l2": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.0003
        },
        "forward_max_abs": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.003
        }
      },
      "additionalProperties": true
    },
    "latency_ms": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "real_input_tok_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "peak_GiB": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "samples_ms": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "warmups": {
      "type": "integer",
      "const": 2
    },
    "timed_repetitions": {
      "type": "integer",
      "const": 5
    },
    "timing": {
      "type": "object",
      "required": [
        "boundaries",
        "real_input_tokens",
        "valid_targets",
        "intervals"
      ],
      "properties": {
        "boundaries": {
          "const": {
            "clock": "cuda_events",
            "start": "after_input_transfer_valid_target_count_and_zero_grad_before_forward",
            "end": "after_loss_backward_before_zero_grad_and_cleanup",
            "synchronize_before_start": true,
            "synchronize_after_end": true,
            "includes": [
              "forward",
              "masked_cross_entropy",
              "backward"
            ],
            "excludes": [
              "input_transfer",
              "optimizer_step",
              "zero_grad",
              "cleanup"
            ],
            "peak_memory_scope": "max_allocated_across_warmup_and_timed_forward_backward"
          }
        },
        "real_input_tokens": {
          "const": 65536
        },
        "valid_targets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "intervals": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": false,
          "prefixItems": [
            {
              "$ref": "#/$defs/interval",
              "properties": {
                "phase": {
                  "const": "warmup_1"
                }
              }
            },
            {
              "$ref": "#/$defs/interval",
              "properties": {
                "phase": {
                  "const": "warmup_2"
                }
              }
            },
            {
              "$ref": "#/$defs/interval",
              "properties": {
                "phase": {
                  "const": "timing_1"
                }
              }
            },
            {
              "$ref": "#/$defs/interval",
              "properties": {
                "phase": {
                  "const": "timing_2"
                }
              }
            },
            {
              "$ref": "#/$defs/interval",
              "properties": {
                "phase": {
                  "const": "timing_3"
                }
              }
            },
            {
              "$ref": "#/$defs/interval",
              "properties": {
                "phase": {
                  "const": "timing_4"
                }
              }
            },
            {
              "$ref": "#/$defs/interval",
              "properties": {
                "phase": {
                  "const": "timing_5"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "required": [
        "status",
        "peak_GiB",
        "capacity_GiB"
