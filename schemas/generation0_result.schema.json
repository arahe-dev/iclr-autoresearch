      "type": "object",
      "required": [
        "candidate_commit",
        "candidate_branch",
        "attempt_id",
        "pid",
        "gpu",
        "supervisor_gpu",
        "champion_immutable"
      ],
      "properties": {
        "candidate_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidate_branch": {
          "type": "string",
          "pattern": "^codex/(generation0|experiment)/"
